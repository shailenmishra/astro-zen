---
import type { HeroProps } from "@types";
import { Image } from "astro:assets";
type Props = HeroProps;

const { name, specialty } = Astro.props;
---

<section class="flex flex-col items-center text-center py-12" id="hero">
  <h1 class="mb-6 md:mb-8">
    <Image
      src="/hnd_logo_2.jpg"
      alt="Logo of Hope of New Dawn, LLC, which includes the image of a crescent moon and a rising sun inside a rectangular box"
      width={103}
      height={300}
      class="h-auto w-[103px] max-w-full object-contain"
      loading="eager"
    />
  </h1>
  <p
    class="hero-subheading whitespace-pre-line mb-9 font-serif text-3xl leading-11.5 font-bold tracking-tighter text-primary sm:text-4xl md:text-5xl"
  >
    {specialty}
  </p>

</section>

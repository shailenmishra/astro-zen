---
import type { HeroProps } from "@types";
import { Image } from "astro:assets";
type Props = HeroProps;

const { name, specialty, summary, email } = Astro.props;
---

<section class="flex flex-col items-center text-center py-12" id="hero">
  <h1 class="mb-6 md:mb-8">
    <Image
      src="/hnd_logo_l.jpg"
      alt={name}
      width={243}
      height={384}
      class="h-auto w-32 max-w-full object-contain sm:w-40 md:w-48 lg:w-56"
      loading="eager"
    />
  </h1>
  <p
    class="hero-subheading mb-9 font-serif text-3xl leading-11.5 font-bold tracking-tighter text-primary sm:text-4xl md:text-5xl"
  >
    {specialty}
  </p>

</section>
